// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model ThemeSettings {
  id Int @id @default(autoincrement())
}
